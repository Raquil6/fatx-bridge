<Window x:Class="FatxBridge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FATX Bridge 0.2.0 Beta" Height="650" Width="920" MinHeight="500" MinWidth="700"
        Background="#0E1116" Foreground="#EEF4F0" WindowStartupLocation="CenterScreen">
  <Grid Margin="30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel LastChildFill="False">
      <StackPanel><TextBlock Text="FATX BRIDGE" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Free FATX drive access for Windows" Foreground="#9AA7A1" Margin="0,4,0,0"/></StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="Back" Click="Back_Click" IsEnabled="{Binding CanNavigateBack}" />
        <Button Content="Refresh" Click="Refresh_Click" IsEnabled="{Binding IsNotBusy}" />
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Margin="0,22,0,16" Padding="12" CornerRadius="6" Background="#171B22">
      <TextBlock Text="{Binding Status}" Foreground="#B5C4BD" TextWrapping="Wrap" />
    </Border>
    <Grid Grid.Row="2">
      <Grid x:Name="DrivePanel">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Detected Xbox drives and memory cards" FontSize="16" FontWeight="SemiBold" />
        <ListBox Grid.Row="1" Margin="0,12,0,12" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}" IsEnabled="{Binding IsNotBusy}" Background="#171B22" BorderThickness="0">
          <ListBox.ItemTemplate><DataTemplate><Border Padding="16" Margin="4" Background="#202631" CornerRadius="5"><StackPanel>
            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Details}" Foreground="#A9B7B0" Margin="0,5,0,0"/>
          </StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="Open Drive" Click="OpenDrive_Click" IsEnabled="{Binding CanOpen}"/><TextBlock Text="Only disks with a validated FATX partition are shown." VerticalAlignment="Center" Foreground="#89968F"/></StackPanel>
      </Grid>
      <Grid x:Name="PartitionPanel" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="FATX partitions" FontSize="16" FontWeight="SemiBold"/><ListBox Margin="0,12,0,0" ItemsSource="{Binding Partitions}" SelectedItem="{Binding SelectedPartition}" SelectionChanged="Partition_SelectionChanged" IsEnabled="{Binding IsNotBusy}" Background="#171B22" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Padding="12" Margin="3" Background="#202631" CornerRadius="5"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Details}" Foreground="#A9B7B0" FontSize="12"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="Root directory" FontSize="16" FontWeight="SemiBold"/><WrapPanel Margin="0,10,0,0"><Button Content="Mount read-only" Click="MountReadOnly_Click" IsEnabled="{Binding CanMount}"/><Button Content="Mount read/write (experimental)" Click="MountReadWrite_Click" IsEnabled="{Binding CanMountReadWrite}"/><Button Content="Open in Explorer" Click="OpenExplorer_Click" IsEnabled="{Binding IsMounted}"/><Button Content="Unmount" Click="Unmount_Click" IsEnabled="{Binding IsMounted}"/></WrapPanel><ListView Margin="0,12,0,0" ItemsSource="{Binding RootEntries}" Background="#171B22" BorderThickness="0"><ListView.View><GridView><GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="220"/><GridViewColumn Header="Type" DisplayMemberBinding="{Binding Type}" Width="90"/><GridViewColumn Header="Size" DisplayMemberBinding="{Binding Size}" Width="110"/></GridView></ListView.View></ListView></StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
