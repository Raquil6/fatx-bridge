<Application x:Class="FatxBridge.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#171B22" />
    <SolidColorBrush x:Key="Accent" Color="#64D5A4" />
    <Style TargetType="Button">
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Foreground" Value="#EEF4F0" />
      <Setter Property="Background" Value="#284438" />
    </Style>
  </Application.Resources>
</Application>
